// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "(Editor && vim_mode == normal && !menu) || (ProjectPanel && !editiing) || (GitPanel) || Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "space l f": "editor::Format",
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f b": "tab_switcher::OpenInActivePane",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "L": "pane::ActivateNextItem",
      "H": "pane::ActivatePreviousItem",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space e": "project_panel::Toggle",
      "ctrl-'": "workspace::ToggleBottomDock",
      "space p": "editor::Format",
      "space v": "pane::SplitRight",
      "space c": "pane::CloseActiveItem",
      "space h": "workspace::ActivateNextPane",
      "space l": "workspace::ActivatePreviousPane",
      "space q a": "pane::CloseAllItems",
      "space q q": "pane::CloseCleanItems",
      "space z": "workspace::ToggleZoom",
    },
  },
  {
    "context": "(ProjectPanel && not_editing) || EmptyPane",
    "bindings": {
      "space e": "workspace::ToggleLeftDock",
      "escape": "menu::Cancel",
      "space f f": "file_finder::Toggle",
      "space g g": "git_panel::Toggle",
      "space g b": "git::Blame",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "x": "project_panel::Cut",
      "d": "project_panel::Delete",
      "a": "project_panel::NewFile",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-'": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "(Editor && vim_mode == normal && vim_operator == none && !VimWaiting) || (EmptyPane || SharedScreen)",
    "bindings": {
      "space ctrl-o": "workspace::Open",
      "space o": "projects::OpenRecent",
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu && !CommitEditor",
    "bindings": {
      "space g g": "git_panel::Toggle",
      "space g b": "git::Blame",
    },
  },
  {
    "context": "(GitPanel && menu) || (Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu)",
    "bindings": {
      "space g g": "workspace::ToggleRightDock",
      "q": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-right": "vim::ResizePaneRight",
      "alt-left": "vim::ResizePaneLeft",
      "alt-up": "vim::ResizePaneUp",
      "alt-down": "vim::ResizePaneDown",
      "alt-[": "workspace::ToggleLeftDock",
      "alt-]": "workspace::ToggleRightDock",
    }
  },
  {
    "context": "extension == md",
    "bindings": {
      "space ctrl-p": "markdown::OpenPreviewToTheSide",
    }
  }
]
