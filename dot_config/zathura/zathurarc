set adjust-open "best-fit"
set smooth-scroll "true"
set pages-per-row 1

map b adjust-window-to-best-fit
map [normal] <C-d> scroll half-down
map [normal] <C-u> scroll half-up

map <C-b> feedkeys ":bmark "

map <C-l> feedkeys ":blist "
map <C-j> focus_inputbar ":bjump "
map <C-i> focus_inputbar ":bdelete "


