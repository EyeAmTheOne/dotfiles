set adjust-open "best-fit"
set smooth-scroll "true"
set pages-per-row 1

map b adjust-window-to-best-fit
map [normal] <C-d> scroll half-down
map [normal] <C-u> scroll half-up

map <M-b> feedkeys ":bmark "

map <M-l> feedkeys ":blist "
map <M-j> focus_inputbar ":bjump "
map <M-d> focus_inputbar ":bdelete "


